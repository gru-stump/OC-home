rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 : 아래 이메일을 내 구글 이메일로 바꾸세요 (설치 화면 #setup 에서 자동으로 만들어 줘요)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL_HERE'
        && request.auth.token.email_verified == true;
    }

    // 방명록 (컬렉션 이름 : guests)
    match /guests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'secret', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.secret is bool
        && request.resource.data.createdAt == request.time;
      allow read: if resource.data.secret == false || isAdmin();
      allow update, delete: if isAdmin();
    }

    // 사이트 설정 (편집기가 저장하는 곳)
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 방문 통계 (stats.js) : 방문자는 숫자 한 칸을 +1 하는 것만, 읽기는 관리자만
    function statKey(k) {
      return k.matches('^(v|n|p_[a-z]{1,16}|s_[a-z0-9]{1,10}|sr_[a-z0-9]{1,10}|g_[a-z0-9]{1,10})$');
    }
    match /stats/{day} {
      allow read, delete: if isAdmin();
      allow create: if day.matches('^d[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().size() == 1
        && statKey(request.resource.data.keys()[0])
        && request.resource.data[request.resource.data.keys()[0]] == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && statKey(request.resource.data.diff(resource.data).affectedKeys().toList()[0])
        && request.resource.data[request.resource.data.diff(resource.data).affectedKeys().toList()[0]]
           == resource.data.get(request.resource.data.diff(resource.data).affectedKeys().toList()[0], 0) + 1;
    }
  }
}